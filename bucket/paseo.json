{
    "version": "0.15.4",
    "description": "Desktop client for orchestrating multiple coding agents (Claude Code, Codex, Copilot, OpenCode, Pi)",
    "homepage": "https://paseo.sh",
    "license": "Apache-2.0",
    "notes": [
        "Paseo runs a local daemon: the desktop app starts it automatically on launch.",
        "At least one agent CLI (Claude Code, Codex, GitHub Copilot, OpenCode, Pi) must be installed and configured."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/getpaseo/paseo/releases/download/v0.15.4/Paseo-Setup-0.15.4-x64.exe#/dl.7z",
            "hash": "sha512:3e6bc53725798cb015594e07e5ae2baaa3c801eb40eaac8b849093bcd85d557648f146a99e79b08f4db7e3723e1808317dcf99f1fb25686b422187ded069450f",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/getpaseo/paseo/releases/download/v0.15.4/Paseo-Setup-0.15.4-arm64.exe#/dl.7z",
            "hash": "sha512:78889cc9348fdd3cb791f382398a3286d9da03bc7e9624feb02544a9d132137e8c97632406ef6fbd1c9f6a636effb98448b46f38af94a86216d6a195269e6e78",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
            ]
        }
    },
    "bin": [
        [
            "resources\\bin\\paseo.cmd",
            "paseo"
        ]
    ],
    "shortcuts": [
        [
            "Paseo.exe",
            "Paseo"
        ]
    ],
    "checkver": {
        "github": "https://github.com/getpaseo/paseo"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/getpaseo/paseo/releases/download/v$version/Paseo-Setup-$version-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "-x64\\.exe[\\s\\S]*?sha512:\\s+$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/getpaseo/paseo/releases/download/v$version/Paseo-Setup-$version-arm64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "-arm64\\.exe[\\s\\S]*?sha512:\\s+$base64"
                }
            }
        }
    }
}
